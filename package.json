{
  "name": "omp-bilingual",
  "version": "0.1.6",
  "type": "module",
  "license": "MIT",
  "description": "Paragraph-level Chinese/English cards for English assistant replies",
  "keywords": ["omp", "oh-my-pi", "extension", "translate", "bilingual"],
  "omp": {
    "extensions": ["./src/index.ts"],
    "settings": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Translate English assistant prose into a bilingual card"
      },
      "backend": {
        "type": "enum",
        "values": ["google", "deepseek", "hunyuan"],
        "default": "google",
        "description": "Translation backend"
      },
      "target": {
        "type": "string",
        "default": "zh-CN",
        "description": "Target language code (Google uses this; LLM backends always emit Simplified Chinese)"
      },
      "deepseekApiKey": {
        "type": "string",
        "secret": true,
        "description": "DeepSeek API key (set via /bilingual configure)"
      },
      "deepseekModel": {
        "type": "string",
        "default": "deepseek-v4-flash",
        "description": "DeepSeek model id"
      },
      "hunyuanApiKey": {
        "type": "string",
        "secret": true,
        "description": "Hunyuan / TokenHub API key (set via /bilingual configure)"
      },
      "hunyuanBaseUrl": {
        "type": "string",
        "default": "https://api.hunyuan.cloud.tencent.com/v1",
        "description": "Hunyuan OpenAI-compatible base URL"
      },
      "hunyuanModel": {
        "type": "string",
        "default": "hunyuan-turbos-latest",
        "description": "Hunyuan model id"
      }
    }
  }
}
